# Copy to .env for local work. In Coolify, set these as environment variables instead. Placeholders only.
ENV=production                      # development | test | production
DATABASE_URL=postgresql://hub:CHANGE_ME@db:5432/deskhub
SECRET_KEY=                         # 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
PUBLIC_URL=https://hub.citichoice.net

# Two hostnames. deskhub serves ONLY /ui and /auth; hub serves ONLY the machine API (/admin, /internal, /healthz).
STAFF_UI_HOST=deskhub.citichoice.net
API_HOST=hub.citichoice.net

# Zitadel (staff sign-in). Create the application in the "Citichoice Desk Hub" project: Web, Code flow, Basic auth.
OIDC_ISSUER=https://accounts.citichoice.co
OIDC_CLIENT_ID=                     # from Zitadel (not secret)
OIDC_CLIENT_SECRET=                 # from Zitadel; set ONLY in Coolify, never in git or chat
OIDC_REDIRECT_URI=https://deskhub.citichoice.net/auth/callback
OIDC_POST_LOGOUT_URI=https://deskhub.citichoice.net/auth/logged-out
OIDC_PROJECT_ID=396543381326529539
OIDC_REQUIRED_ROLE=administrator

# WiseCP exchange rates (read-only). The hub reads the rates WiseCP already maintains; it does not call exchangerate-api.com itself.
WISECP_API_URL=                     # e.g. https://billing.citichoice.co (no trailing slash)
WISECP_API_KEY=                     # a READ-ONLY WiseCP API key restricted to the finance scope; set only in Coolify
WISECP_BASE_CURRENCY=USD            # the hub refuses WiseCP's rates if its base currency ever changes
FX_MAX_AGE_HOURS=48                 # a rate older than this (at message time) is refused
FX_QUARANTINE_PCT=25                # a rate move bigger than this waits for staff approval
PROVIDER_CURRENCY=USD               # the currency Meta bills Citichoice in

CHATWOOT_URL=                       # your Chatwoot base URL
CHATWOOT_PLATFORM_TOKEN=            # Chatwoot Super Admin > Platform Apps
WISECP_TOPUP_URL=
FX_BUFFER_PCT=0.03
MARKETING_MIN_BALANCE_USD=5         # converted to each wallet's currency at the current FX rate
TRUSTED_PROXY_HOPS=1                # Coolify/Traefik only = 1. Verify with a real request before relying on IP allow-lists.
ADJUSTMENT_SELF_APPROVAL_LIMIT_USD=0   # a person may approve their OWN manual money change only up to this USD amount. 0 = never (recommended)
CUSTOMER_API_ENABLED=false          # customer routes stay off until a customer dashboard is approved

# Customer stats (conversations / messages per channel). A dedicated Chatwoot user, added as administrator of every tenant workspace
# (python -m app.cli add-reporter <chatwoot_user_id>). Its personal access token goes here. Read-only use; never a Platform App token.
CHATWOOT_REPORT_TOKEN=
STATS_CACHE_SECONDS=120

# WhatsApp credit bought in WiseCP (docs/WISECP_AUDIT.md). WISECP_API_KEY must now ALSO be allowed to read invoices.
WISECP_TOPUP_ADDON_ID=48
WISECP_TOPUP_DESCRIPTION=WhatsApp Prepaid Wallet Top-Up
TOPUP_REVIEW_THRESHOLD_USD=0        # a paid invoice with no/short payment record credits up to this USD amount, above it waits for staff. 0 = always waits
